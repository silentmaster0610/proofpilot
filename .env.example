# Run npm run setup, then create an account at /login with an 8+ character password.
# Optional legacy owner/judge keys are generated in ignored .env.
# Optional live inference (leave empty for sample-only use).
NEBIUS_API_KEY=
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b
LIVE_DAILY_LIMIT=30
# Optional locally; required for durable storage on free Render.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Alternative: absolute path of a private token file (for Render, /etc/secrets/<filename>).
# An explicitly populated TURSO_AUTH_TOKEN takes precedence.
TURSO_AUTH_TOKEN_FILE=
REQUIRE_REMOTE_DB=false
DATABASE_PATH=./data/proofpilot.sqlite
FOLLOWUP_SCANNER=true
# Local origin. On Render, omit this and use automatic RENDER_EXTERNAL_URL.
# APP_URL=http://127.0.0.1:3000
